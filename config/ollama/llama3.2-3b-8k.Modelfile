# Llama 3.2 3B with an 8,192-token context window for the model comparison (M2, docs/week1_plan.txt §3).
# Ollama's default window (2,048-4,096 tokens) silently drops the start of longer prompts, and B0 prompts with
# their passages reach ~5,000 tokens. Create it once:   ollama create llama3.2-3b-8k -f config/ollama/llama3.2-3b-8k.Modelfile
FROM llama3.2:3b
PARAMETER num_ctx 8192
