# Secrets (.env, and variants such as .env.local; the template stays tracked)
.env
.env.*
!.env.example
# TLS certificates for the hosted endpoint (group-specific; keep them out of the repo)
certs/
*.crt
*.pem

# Downloaded / generated data (keep only the folder placeholders)
data/raw/*
data/sections/*
data/xbrl/*
data/chunks/*
data/index/*
!data/**/.gitkeep

# Python / editors
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/
.DS_Store
.vscode/
.idea/
