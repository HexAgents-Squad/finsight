# ==========================================
# FinSight - environment config (copy to .env; never commit .env)
# Switching from local Ollama to the official endpoint = editing this file only.
# ==========================================

# Chat model: any OpenAI-compatible endpoint (Ollama locally)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.2:3b
LLM_TIMEOUT=30.0
LLM_HTTP_RETRIES=2
LLM_JSON_RETRIES=2

# Embeddings: "openai" uses the endpoint below; "sentence-transformers" runs locally (no server needed)
EMBED_BACKEND=openai
EMBED_BASE_URL=http://localhost:11434/v1
EMBED_API_KEY=ollama
EMBED_MODEL=nomic-embed-text
EMBED_LOCAL_MODEL_NAME=all-MiniLM-L6-v2
EMBED_BATCH_SIZE=64

# Agent limits
MAX_AGENT_STEPS=10
MAX_TOKENS_PER_QUERY=12000

# SEC EDGAR requires automated clients to identify themselves: team name + your contact email
SEC_USER_AGENT=HexAgents_Squad IITKGP your-name@example.com
