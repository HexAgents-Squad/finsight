# ==========================================
# FinSight - environment config (copy to .env; never commit .env)
# Switching from local Ollama to the official endpoint = editing this file only.
# ==========================================

# Chat model: any OpenAI-compatible endpoint. Local stand-in: Ollama (below).
# Hosted endpoint (Week 1, LOCAL_SETUP.md "Hosted endpoint"): use your group's values from the learner guide:
#   LLM_BASE_URL=https://<group host>:<port>/v1
#   LLM_API_KEY=<team key: never commit, screenshot or share it outside the team>
#   LLM_MODEL=Qwen/Qwen3-8B
#   LLM_CA_CERT=certs/<group>-ca.crt
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.2:3b
LLM_TIMEOUT=30.0
# 429/5xx/timeouts/network errors are retried after 2, 4, 8 s (LLM_RETRY_BASE_S doubling); one request at a time
# per endpoint, at most one start per LLM_MIN_INTERVAL_S (the team key allows 1 active request, 60 per minute)
LLM_HTTP_RETRIES=3
LLM_RETRY_BASE_S=2.0
LLM_MIN_INTERVAL_S=1.0
# Reply cache (git-ignored): identical requests are answered from disk, so evaluation re-runs are free and
# identical. Empty = off. Delete the folder to force fresh calls.
LLM_CACHE_DIR=data/cache/llm
LLM_JSON_RETRIES=2
LLM_MAX_COMPLETION_TOKENS=1024
# Prompt + reply limit per call (the endpoint's 8,192); a request that cannot fit is refused before sending
LLM_CONTEXT_TOKENS=8192
# The group's CA certificate (PEM) for an https:// endpoint; empty = the HTTP library's default trust store (Ollama needs none).
# Relative paths are taken from the repo root; certs/ is git-ignored. HTTPS verification is never switched off.
LLM_CA_CERT=
# Qwen3 reasoning mode: false = answer directly (default); true = reasoning first (removed from replies, but it
# spends output tokens). Empty = do not send the switch at all, for an endpoint that rejects unknown fields.
# The provided endpoint ignores the switch and always answers without reasoning (checked 10 Nov).
LLM_ENABLE_THINKING=false

# Embeddings: "sentence-transformers" (default) runs locally, no server needed; the first run downloads the
# model from Hugging Face (~90 MB, about 40 s). "openai" uses the endpoint below.
# The retrieval index is built with the local model (23 vs 2.7 chunks/s for nomic-embed-text via Ollama on a CPU,
# ADR-013) and records it: searching with different EMBED_* settings is an error until you re-run
# ingest/04_index.py with them.
EMBED_BACKEND=sentence-transformers
# Leave empty to use the chat endpoint and key above; set only if embeddings have their own endpoint
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=nomic-embed-text
EMBED_LOCAL_MODEL_NAME=all-MiniLM-L6-v2
EMBED_BATCH_SIZE=64

# Agent limits
MAX_AGENT_STEPS=10
MAX_TOKENS_PER_QUERY=12000
QUERY_TIMEOUT_S=60

# SEC EDGAR requires automated clients to identify themselves: team name + your contact email
SEC_USER_AGENT=HexAgents_Squad IITKGP your-name@example.com
